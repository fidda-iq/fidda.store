/*
  Cache HTML/JS aggressively enough for speed, but allow versioned assets to update.
*/
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/products.html
  Cache-Control: no-cache, no-store, must-revalidate
/product.html
  Cache-Control: no-cache, no-store, must-revalidate
/cart.html
  Cache-Control: no-cache, no-store, must-revalidate
/checkout.html
  Cache-Control: no-cache, no-store, must-revalidate
